rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is Admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin@admin.com' ||
        request.auth.token.email == 'ghoshabhijit1295@gmail.com' ||
        request.auth.token.email == 'dipakrvscet122@gmail.com'
      );
    }

    // 1. Everyone can view images (so your website loads fast for customers)
    match /{allPaths=**} {
      allow read: if true;
    }

    // 2. Profile Photos: Customers can only upload THEIR OWN profile photo
    match /profilePhotos/{fileName} {
      // Ensures the uploaded file name starts with their own User ID
      allow write: if request.auth != null && fileName.matches(request.auth.uid + '-.*');
    }

    // 3. Admin Uploads: Only Admins can upload Product, Category, or Banner images
    match /products/{fileName} {
      allow write: if isAdmin();
    }
    match /categories/{fileName} {
      allow write: if isAdmin();
    }
    match /banners/{fileName} {
      allow write: if isAdmin();
    }

    // Default block for anything else
    match /{allPaths=**} {
      allow write: if isAdmin();
    }
  }
}
