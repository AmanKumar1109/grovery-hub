rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@admin.com' ||
        request.auth.token.email == 'ghoshabhijit1295@gmail.com' ||
        request.auth.token.email == 'dipakrvscet122@gmail.com'
      );
    }

    // 1. Users can only access their own profile data. Admins can access all.
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 2. Orders: Customers can only read/create their own orders. Admin controls everything.
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Normal user cannot update status (like to Paid) from client side
      allow update, delete: if isAdmin();
    }

    // 3. Mail Collection: Used by the frontend to trigger welcome emails
    match /mail/{mailId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // 4. Public Read Data: Anyone can view these, but ONLY Admin can edit/delete them.
    match /items/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /pages/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /staff/{document=**} {
      allow read, write: if isAdmin();
    }
    match /auditLogs/{document=**} {
      allow read, write: if isAdmin();
    }
    match /complaints/{document=**} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }
    match /customer_reviews/{document=**} {
      // Anyone can submit a review, and everyone can read them
      allow create, read: if true;
      allow update, delete: if isAdmin();
    }

    match /referrals/{referralId} {
      // User can read if they are referrer or referred user
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.referrerId == request.auth.uid || 
        resource.data.referredUserId == request.auth.uid
      );
      // NO client writes allowed
      allow write: if isAdmin(); 
    }

    match /scratchCards/{scratchCardId} {
      // User can read their own cards
      allow read: if isAdmin() || isOwner(resource.data.userId);
      // NO client writes allowed
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      // User can read global coupons (no userId) OR their own coupons
      allow read: if isAdmin() || !('userId' in resource.data) || isOwner(resource.data.userId);
      // NO client writes allowed (admin writes from backend)
      allow write: if isAdmin();
    }
  }
}
